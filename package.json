{
  "name": "prettier-plugin-unocss",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.4",
  "description": "Prettier plugin that sorts UnoCSS utilities using your own uno.config",
  "license": "MIT",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "unocss"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
