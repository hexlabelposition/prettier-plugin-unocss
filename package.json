{
  "name": "prettier-plugin-unocss",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.28.4",
  "description": "Prettier plugin that sorts UnoCSS utilities using your own uno.config",
  "license": "MIT",
  "keywords": [
    "prettier",
    "prettier-plugin",
    "unocss"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc && tsc -p playground",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "play": "pnpm build && prettier --plugin=./dist/index.mjs playground/example.tsx",
    "bench": "pnpm build && node bench/index.ts"
  },
  "peerDependencies": {
    "prettier": "^3.0.0"
  },
  "dependencies": {
    "@unocss/config": "^66.12.0",
    "@unocss/core": "^66.12.0",
    "unconfig": "^7.5.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@iconify-json/svg-spinners": "^1.2.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.1",
    "@unocss/eslint-plugin": "^66.12.0",
    "astro-eslint-parser": "^3.2.0",
    "clsx": "^2.1.1",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-svelte": "^4.1.1",
    "react": "^19.3.1",
    "svelte": "^5.57.3",
    "svelte-eslint-parser": "^1.10.1",
    "tailwind-variants": "^4.0.1",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "unocss": "^66.12.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1"
  }
}
