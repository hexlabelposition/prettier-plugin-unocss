---
const { active, color } = Astro.props
---
<div class:list={['p-4 flex', active && 'underline text-red-500', { 'm-2 block': active, flex: !active }, ['p-2 block']]}>
  <span class={active ? 'p-4 flex' : 'm-2 block'}>conditional</span>
  <span class={`p-4 flex ${active ? 'm-2 block' : ''} text-${color}-500 p-2 block`}>template</span>
  <span class={{ 'p-4 flex': active }.toString()}>object keys outside class:list are left alone</span>
  <span class="
    p-4
    flex
  ">multiline</span>
  <span class="content-[&quot;x&quot;] p-4 flex">entity</span>
  <span class="p-4 &nbsp; flex">unknown entity, left alone</span>
  {active && <i class={clsx('p-4 flex')}>{clsx('m-2 block')}</i>}
</div>
<script>
  const c = clsx('p-4 flex')
</script>
